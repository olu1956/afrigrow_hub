# Supabase — copy to .env.local (local) and to your host's env vars (production).
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Production site URL (required for sitemap, Open Graph, auth redirects)
# Local: http://localhost:3000
# Production (preferred): https://www.afrigrow.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated login emails allowed to view /dashboard/admin/*
# Must match the email you sign in with (Settings → Login email).
PLATFORM_ADMIN_EMAILS=ojuroyeolu@gmail.com

# Recommended for production: reliable admin detection and server-side admin writes
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Billing emails (Save & mark sent). Create a free key at https://resend.com
# Until send.afrigrow.app is verified, omit BILLING_FROM_EMAIL (uses onboarding@resend.dev;
# Resend will only deliver to the account owner's email). After verification:
# BILLING_FROM_EMAIL=AfriGrow Hub <billing@send.afrigrow.app>
RESEND_API_KEY=
BILLING_FROM_EMAIL=AfriGrow Hub <onboarding@resend.dev>

# Without Supabase variables the app runs in preview mode (localStorage auth).

# --- Free launch deploy checklist (production) ---
# 1. Create Supabase project + run SQL scripts in supabase/scripts/
# 2. Set all env vars above on Vercel (or your host)
# 3. npm run build && deploy
# 4. Supabase → Authentication → URL config: add your production domain
# 5. Admin: publish Business Academy guides at /dashboard/admin/guides
# 6. Smoke test: signup → profile → contact form → admin inbound leads
