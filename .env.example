# Supabase — copy to .env.local (local) and to your host's env vars (production).
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Production site URL (required for sitemap, Open Graph, auth redirects)
# Local: http://localhost:3000
# Production (required on Vercel): https://www.afrigrow.app
# If this is missing or set to localhost in production, password-reset emails
# will break (users land on "localhost cannot be reached").
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated login emails allowed to view /dashboard/admin/*
# Must match the email you sign in with (Settings → Login email).
PLATFORM_ADMIN_EMAILS=ojuroyeolu@gmail.com

# Recommended for production: reliable admin detection and server-side admin writes
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Outbound email (invoices, quotes, and admin alerts for new members / contact).
# Create a free key at https://resend.com. send.afrigrow.app must be verified.
RESEND_API_KEY=
BILLING_FROM_EMAIL=AfriGrow Hub <billing@send.afrigrow.app>

# Without Supabase variables the app runs in preview mode (localStorage auth).

# --- Help assistant (/help) ---
# Optional. If AI_API_KEY is empty, the assistant answers only from excerpts in
# src/lib/assistant/knowledge.ts and does not call a model.
# Never put a real key in this file. Set it in .env.local or the host's env.
AI_API_KEY=
# OpenAI-compatible base URL. Change this to swap provider later.
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Site paths only. Do not invent a privacy policy or support address here.
ASSISTANT_PRIVACY_PATH=/privacy
ASSISTANT_SUPPORT_PATH=/contact
# In-memory limit per server instance, per minute. Not shared across instances.
ASSISTANT_RATE_LIMIT_PER_MINUTE=12
# Outcome logs only (source paths, no message text) when true.
ASSISTANT_LOG_DIAGNOSTICS=false
# Keep false. True writes a redacted copy of the latest question to server logs.
ASSISTANT_LOG_MESSAGES=false

# Growth Journey, startup drafts, Friday submissions, and in-app notifications
# need supabase/scripts/setup_member_growth_journey.sql in the Supabase SQL Editor.
# No extra API keys. Friday review uses the existing platform-admin allowlist.

# --- Free launch deploy checklist (production) ---
# 1. Create Supabase project + run SQL scripts in supabase/scripts/
# 2. Set all env vars above on Vercel (or your host)
# 3. npm run build && deploy
# 4. Supabase → Authentication → URL config: add your production domain
# 5. Admin: publish Business Academy guides at /dashboard/admin/guides
# 6. Smoke test: signup → profile → contact form → admin inbound leads
